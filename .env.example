# Supabase PostgreSQL Database & Realtime Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Frontend Client Public Safe Variables (For Realtime browser subscriptions)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Session & Cryptographic CAPTCHA Signing Secret (At least 32 random characters)
SESSION_SECRET=your_long_random_session_and_captcha_signing_secret

# SMTP Mail Delivery Settings (Gmail / University Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_smtp_app_password
ADMIN_EMAIL=your_email@gmail.com

# Server Port (Default: 5000)
PORT=5000
